#!/usr/bin/env bash
# Thin wrapper so `seedbank` can be invoked without spelling out the python path.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "${1:-}" = "mode" ]; then
  shift; exec python3 "$DIR/scripts/cg_mode.py" seedbank "$@"
fi
if [ "${1:-}" = "hook" ] && [ "${2:-}" = "stop" ]; then
  # Claude Code hook. Not on: silent no-op. A crash exits 1 with its traceback on
  # stderr, which Claude Code shows as a non-blocking hook error.
  (cd "${CLAUDE_PROJECT_DIR:-$PWD}" && python3 "$DIR/scripts/cg_mode.py" seedbank --is-on)
  case $? in 0) ;; 3) exit 0 ;; *) exit 1 ;; esac
  python3 "$DIR/scripts/seedbank.py" hook stop
  rc=$?; [ "$rc" -eq 2 ] && exit 1; exit "$rc"  # 2 would block the tool call
fi
if [ "${1:-}" = "hook" ]; then
  # Claude Code hook. Not on: silent no-op. A crash exits 1 with its traceback on
  # stderr, which Claude Code shows as a non-blocking hook error.
  (cd "${CLAUDE_PROJECT_DIR:-$PWD}" && python3 "$DIR/scripts/cg_mode.py" seedbank --is-on)
  case $? in 0) ;; 3) exit 0 ;; *) exit 1 ;; esac
  python3 "$DIR/scripts/seedbank.py" hook >/dev/null
  rc=$?; [ "$rc" -eq 2 ] && exit 1; exit "$rc"  # 2 would block the tool call
fi
exec python3 "$DIR/scripts/seedbank.py" "$@"
