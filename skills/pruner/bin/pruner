#!/usr/bin/env bash
# Thin wrapper so `pruner` can be invoked without spelling out the python path.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "${1:-}" = "mode" ]; then
  shift; exec python3 "$DIR/scripts/cg_mode.py" pruner "$@"
fi
if [ "${1:-}" = "hook" ]; then
  # Claude Code UserPromptSubmit hook: stdout is the hook's JSON answer; never
  # fails the prompt. Runs only while pruner is on.
  (cd "${CLAUDE_PROJECT_DIR:-$PWD}" && python3 "$DIR/scripts/cg_mode.py" pruner --is-on) 2>/dev/null || exit 0
  python3 "$DIR/scripts/pr_hook.py" 2>/dev/null
  exit 0
fi
exec python3 "$DIR/scripts/pruner.py" "$@"
