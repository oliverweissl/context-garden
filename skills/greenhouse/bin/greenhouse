#!/usr/bin/env bash
# Thin wrapper so `greenhouse` can be invoked without spelling out the python path.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ "${1:-}" = "mode" ]; then
  shift; python3 "$DIR/scripts/cg_mode.py" greenhouse "$@" || exit $?
  # Turning it on: find the base now, or settle where it should live.
  if [ "${1:-}" = "on" ]; then python3 "$DIR/scripts/greenhouse.py" check; fi
  exit 0
fi
if [ "${1:-}" = "hook" ]; then
  # Claude Code hook. Not on: silent no-op. A crash exits 1 with its traceback on
  # stderr, which Claude Code shows as a non-blocking hook error.
  (cd "${CLAUDE_PROJECT_DIR:-$PWD}" && python3 "$DIR/scripts/cg_mode.py" greenhouse --is-on)
  case $? in 0) ;; 3) exit 0 ;; *) exit 1 ;; esac
  cd "${CLAUDE_PROJECT_DIR:-$PWD}" && python3 "$DIR/scripts/greenhouse.py" "$@"
  rc=$?; [ "$rc" -eq 2 ] && exit 1; exit "$rc"  # 2 would block the tool call
fi
exec python3 "$DIR/scripts/greenhouse.py" "$@"
