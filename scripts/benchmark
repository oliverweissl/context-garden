#!/usr/bin/env python3
"""Entry point for Context Garden component benchmarks.

    scripts/benchmark list
    scripts/benchmark run [--task ID ...] [--component NAME ...] [--arms ARM ...]
                          [--runs N] [--seed S] [--dry-run] [--resume DIR]
    scripts/benchmark analyze <results-dir>
    scripts/benchmark plot <results-dir>

See docs/benchmarking.md for the methodology (arms, randomised interleaved
schedule, metrics/CIs) and benchmarks/README.md for the fixture format.
`run` spends real API usage/cost: every trial invokes the real `claude`
CLI headlessly (sessions = tasks x arms x runs). `run --dry-run` only
prints the randomised schedule.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import re
import shutil
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_ROOT / "benchmarks"))

from harness.analyze import load_records, write_summary  # noqa: E402
from harness.fixtures import discover_tasks  # noqa: E402
from harness.run import (  # noqa: E402
    RECORDS_FILE,
    SCHEDULE_FILE,
    completed_keys,
    plan_schedule,
    read_schedule,
    run_schedule,
    write_schedule,
)
from harness.runners import ClaudeCodeRunner  # noqa: E402
from harness.types import ARMS  # noqa: E402

RESULTS_DIR = REPO_ROOT / "benchmarks" / "results"

# Runner flags persisted in schedule.json so --resume continues with the same
# runner configuration. argparse defaults are None so explicitly given flags
# can be told apart from omitted ones; omitted flags fall back to these.
RUNNER_DEFAULTS = {
    "runner": "claude-code",
    "model": None,
    "permission_mode": "acceptEdits",
    "max_budget_usd": 1.0,
}


def positive_int(value: str) -> int:
    n = int(value)
    if n < 1:
        raise argparse.ArgumentTypeError(f"must be >= 1, got {n}")
    return n


def _flag(key: str) -> str:
    return "--" + key.replace("_", "-")


def _resolve_runner_config(args: argparse.Namespace, stored: dict | None) -> dict:
    """Runner config for this invocation. Fresh run: flags over defaults.
    Resume: the config stored in schedule.json, with explicitly given flags
    allowed only if they match it (ValueError otherwise). Schedules written
    before the config was stored fall back to flags/defaults."""
    given = {k: getattr(args, k) for k in RUNNER_DEFAULTS if getattr(args, k) is not None}
    if stored is None:
        return {**RUNNER_DEFAULTS, **given}
    conflicts = [
        f"{_flag(k)}={v!r} (stored: {stored[k]!r})"
        for k, v in given.items()
        if k in stored and stored[k] != v
    ]
    if conflicts:
        raise ValueError(
            "runner flag(s) differ from the resumed run's schedule.json: "
            + ", ".join(conflicts)
            + "; omit them to reuse the stored values"
        )
    return {**RUNNER_DEFAULTS, **given, **stored}


def cmd_list(args: argparse.Namespace) -> int:
    tasks = discover_tasks()
    if not tasks:
        print("No benchmark fixtures found under benchmarks/fixtures/.")
        return 0
    for task in tasks:
        skills = ",".join(task.skill_relevance)
        note = "" if task.run_by_default else "  (not run by default -- needs --task/--component)"
        print(
            f"{task.task_id:<40} component={task.component:<10} level={task.level:<4} "
            f"skills=[{skills}]{note}"
        )
    return 0


def _select_tasks(args: argparse.Namespace):
    tasks = discover_tasks()
    explicit = bool(args.task or args.component)
    if args.task:
        tasks = [t for t in tasks if t.task_id in set(args.task)]
    if args.component:
        wanted = set(args.component)
        tasks = [t for t in tasks if t.component in wanted]
    if not explicit:
        skipped = [t.task_id for t in tasks if not t.run_by_default]
        tasks = [t for t in tasks if t.run_by_default]
        if skipped:
            print(f"Skipping (not run by default, needs --task/--component): {', '.join(skipped)}")
    return tasks


REPO_ROOT = Path(__file__).resolve().parent.parent
PUBLISHED_DIR = REPO_ROOT / "docs" / "benchmarks"
README = REPO_ROOT / "README.md"
FIGURE_BEGIN = "<!-- benchmark-figure:begin -->"
FIGURE_END = "<!-- benchmark-figure:end -->"


def _plugin_version() -> str:
    """The context-garden version under test, from .claude-plugin/plugin.json."""
    manifest = REPO_ROOT / ".claude-plugin" / "plugin.json"
    return json.loads(manifest.read_text(encoding="utf-8"))["version"]


def _run_version(results_dir: Path) -> str | None:
    """Version recorded in a results dir's schedule.json (None for pre-0.2 runs)."""
    path = results_dir / SCHEDULE_FILE
    if not path.exists():
        return None
    return json.loads(path.read_text(encoding="utf-8")).get("version")


def _publish(results_dir: Path, version: str) -> Path:
    """Copy figure + summary to docs/benchmarks/v<version>/ and point the README at it."""
    dest = PUBLISHED_DIR / f"v{version}"
    dest.mkdir(parents=True, exist_ok=True)
    for name in ("benchmark.png", "summary.md"):
        if (results_dir / name).exists():
            shutil.copy2(results_dir / name, dest / name)
    rel = dest.relative_to(REPO_ROOT).as_posix()
    block = (
        f"{FIGURE_BEGIN}\n"
        f"Benchmark results for **v{version}** on the small fixtures in this repo, run with Claude "
        f"Code ([summary]({rel}/summary.md); older versions in "
        f"[`docs/benchmarks/`](docs/benchmarks)):\n\n"
        f"![Benchmark results for context-garden v{version}]({rel}/benchmark.png)\n"
        f"{FIGURE_END}"
    )
    text = README.read_text(encoding="utf-8")
    pattern = re.compile(re.escape(FIGURE_BEGIN) + r".*?" + re.escape(FIGURE_END), re.DOTALL)
    if pattern.search(text):
        text = pattern.sub(lambda _: block, text)
    else:
        print(f"warning: no {FIGURE_BEGIN} marker in README.md; figure not linked", file=sys.stderr)
    README.write_text(text, encoding="utf-8")
    return dest


def cmd_run(args: argparse.Namespace) -> int:
    if args.resume:
        run_dir = Path(args.resume)
        if not (run_dir / SCHEDULE_FILE).exists():
            print(f"error: no {SCHEDULE_FILE} under {run_dir}", file=sys.stderr)
            return 1
        meta, schedule = read_schedule(run_dir)
        seed, arms, runs = meta["seed"], meta["arms"], meta["runs"]
        by_id = {t.task_id: t for t in discover_tasks()}
        tasks = [by_id[i] for i in meta["tasks"] if i in by_id]
        stored = meta.get("runner_config")
        try:
            config = _resolve_runner_config(args, stored)
        except ValueError as exc:
            print(f"error: {exc}", file=sys.stderr)
            return 1
        print(
            f"Resuming {run_dir} (seed={seed}, arms={arms}, runs={runs}); "
            "task/arm/run/seed flags are ignored"
            + ("; runner config restored from schedule.json." if stored else ".")
        )
    else:
        tasks = _select_tasks(args)
        if not tasks:
            print("No matching fixtures.", file=sys.stderr)
            return 1
        seed, arms, runs = args.seed, list(dict.fromkeys(args.arms)), args.runs
        schedule = plan_schedule([t.task_id for t in tasks], arms, runs, seed)
        run_dir = RESULTS_DIR / dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        config = _resolve_runner_config(args, None)

    records_path = run_dir / RECORDS_FILE
    done = completed_keys(records_path)
    todo = [t for t in schedule if t.key not in done]
    print(
        f"{len(tasks)} task(s) x {len(arms)} arm(s) x {runs} run(s) = {len(schedule)} "
        f"session(s); {len(done & {t.key for t in schedule})} already done, {len(todo)} to run "
        f"(seed={seed}, max ${config['max_budget_usd']:.2f}/session, "
        f"worst case ${len(todo) * config['max_budget_usd']:.2f})."
    )

    if args.dry_run:
        for i, trial in enumerate(schedule):
            mark = "done" if trial.key in done else "    "
            print(f"{i:>4} {mark} {trial.task_id:<40} {trial.arm:<18} rep={trial.rep}")
        print("Dry run: nothing executed.")
        return 0

    if config["runner"] != "claude-code":
        print(
            f"error: unknown --runner {config['runner']!r} (only 'claude-code' is CLI-runnable)",
            file=sys.stderr,
        )
        return 1

    if not args.resume:
        write_schedule(
            run_dir, schedule, seed=seed, arms=arms, runs=runs, runner_config=config,
            version=_plugin_version(),
        )  # fmt: skip
    runner = ClaudeCodeRunner(
        model=config["model"],
        permission_mode=config["permission_mode"],
        max_budget_usd=config["max_budget_usd"],
    )
    print(f"Running against {config['runner']} -- this spends real API usage. Results: {run_dir}")
    keep_workdirs_under = (run_dir / "workdirs") if args.keep_workdirs else None

    def progress(index, total, record):
        status = "PASS" if record.verification_success else "FAIL"
        print(
            f"[{index + 1}/{total}] {record.task_id} {record.condition} rep={record.rep}: "
            f"{status}, {record.total_tokens} tokens"
        )

    try:
        run_schedule(
            tasks,
            runner,
            schedule,
            records_path,
            seed=seed,
            keep_workdirs_under=keep_workdirs_under,
            on_record=progress,
        )
    except ValueError as exc:  # e.g. schedule names a task no longer in fixtures/
        print(f"error: {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print(f"\nInterrupted. Resume with: scripts/benchmark run --resume {run_dir}")
        return 130

    summary = write_summary(load_records(records_path), run_dir / "summary.md")
    print(f"\nRecords: {records_path}")
    print(summary)
    return 0


def cmd_analyze(args: argparse.Namespace) -> int:
    records_path = Path(args.results_dir) / "records.jsonl"
    if not records_path.exists():
        print(f"error: no records.jsonl under {args.results_dir}", file=sys.stderr)
        return 1
    summary = write_summary(load_records(records_path), Path(args.results_dir) / "summary.md")
    print(summary)
    return 0


def cmd_plot(args: argparse.Namespace) -> int:
    from harness.plot import MatplotlibMissing, plot_results_dir

    results_dir = Path(args.results_dir)
    records_path = results_dir / RECORDS_FILE
    if not records_path.exists():
        print(f"error: no {RECORDS_FILE} under {results_dir}", file=sys.stderr)
        return 1
    version = args.version or _run_version(results_dir)
    if args.publish and not version:
        print(
            "error: results dir has no recorded version (pre-0.2 run); pass --version",
            file=sys.stderr,
        )
        return 1
    write_summary(load_records(records_path), results_dir / "summary.md")
    try:
        out = plot_results_dir(results_dir, version=version)
    except (MatplotlibMissing, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    print(f"Wrote {out}")
    if args.publish:
        print(f"Published to {_publish(results_dir, version)} and updated README.md")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="scripts/benchmark")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list", help="list discovered fixtures").set_defaults(func=cmd_list)

    p_run = sub.add_parser("run", help="run a randomised tasks x arms x runs schedule")
    p_run.add_argument("--task", nargs="*", default=None, help="task_id(s) to run (default: all)")
    p_run.add_argument("--component", nargs="*", default=None, help="restrict to component(s)")
    p_run.add_argument(
        "--arms",
        nargs="+",
        default=list(ARMS),
        choices=list(ARMS),
        help="arms to run (default: all three)",
    )
    p_run.add_argument(
        "--runs", type=positive_int, default=10, help="repetitions per (task, arm) (default: 10)"
    )
    p_run.add_argument(
        "--seed", type=int, default=0, help="seed for the randomised interleaved order"
    )
    p_run.add_argument(
        "--dry-run", action="store_true", help="print the schedule and cost bound; run nothing"
    )
    p_run.add_argument(
        "--resume",
        metavar="RESULTS_DIR",
        default=None,
        help="continue an interrupted run (skips completed (task, arm, rep) records)",
    )
    p_run.add_argument(
        "--runner", default=None, choices=["claude-code"], help="(default: claude-code)"
    )
    p_run.add_argument("--model", default=None)
    p_run.add_argument("--permission-mode", default=None, help="(default: acceptEdits)")
    p_run.add_argument("--max-budget-usd", type=float, default=None, help="(default: 1.0)")
    p_run.add_argument(
        "--keep-workdirs",
        action="store_true",
        help="persist materialized working copies to the run's results dir",
    )
    p_run.set_defaults(func=cmd_run)

    p_analyze = sub.add_parser(
        "analyze", help="(re)generate summary.md + summary.json for an existing results dir"
    )
    p_analyze.add_argument("results_dir")
    p_analyze.set_defaults(func=cmd_analyze)

    p_plot = sub.add_parser(
        "plot",
        help="render benchmark.png (per-metric treatment vs baseline delta, 95%% bootstrap CI)",
    )
    p_plot.add_argument("results_dir")
    p_plot.add_argument(
        "--version", default=None, help="version label (default: from the run's schedule.json)"
    )
    p_plot.add_argument(
        "--publish",
        action="store_true",
        help="copy figure + summary to docs/benchmarks/v<version>/ and link it from README.md",
    )
    p_plot.set_defaults(func=cmd_plot)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
