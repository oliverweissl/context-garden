#!/usr/bin/env python3
"""Validate the structure of every Skill under skills/.

Checks (once Skills exist):
  - each skills/<name>/SKILL.md has required frontmatter (name, description)
  - frontmatter is valid YAML (when PyYAML is installed; otherwise a
    substring check) with non-empty name and description
  - referenced files within a Skill actually exist (markdown relative
    links, and `references/...`, `scripts/...`, `bin/...` paths)
  - no Skill references paths outside its own directory (e.g. ../../src)

With no SKILL.md files present yet, this succeeds trivially -- there is
nothing to validate until the first Skill is added.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
SKILLS_DIR = REPO_ROOT / "skills"

try:
    import yaml
except ImportError:  # PyYAML is a dev extra; degrade to a substring check
    yaml = None

# `../` anywhere in a path-like token: from SKILL.md at the skill root, any
# parent-relative reference escapes the skill directory.
FORBIDDEN_PATH_PATTERN = re.compile(r"(?<![\w.])\.\./\S*")
# Markdown relative links: [text](target) -- URLs and in-page anchors skipped below.
LINK_PATTERN = re.compile(r"\]\(([^)\s]+)\)")
# Bare skill-relative paths, e.g. references/schema.md, bin/compost.
SKILL_PATH_PATTERN = re.compile(r"(?<![\w./-])(?:references|scripts|bin)/[\w./-]*[\w-]")


def _check_frontmatter(skill_md: Path, text: str) -> list[str]:
    parts = text.split("---", 2)
    if not text.startswith("---") or len(parts) < 3:
        return [f"{skill_md}: missing YAML frontmatter"]
    frontmatter = parts[1]
    if yaml is None:
        return [
            f"{skill_md}: frontmatter missing '{field}'"
            for field in ("name", "description")
            if f"{field}:" not in frontmatter
        ]
    try:
        data = yaml.safe_load(frontmatter)
    except yaml.YAMLError as exc:
        return [f"{skill_md}: invalid YAML frontmatter: {exc}"]
    if not isinstance(data, dict):
        return [f"{skill_md}: frontmatter is not a YAML mapping"]
    return [
        f"{skill_md}: frontmatter missing '{field}'"
        for field in ("name", "description")
        if not isinstance(data.get(field), str) or not data[field].strip()
    ]


def validate_skill(skill_dir: Path) -> list[str]:
    errors: list[str] = []
    skill_md = skill_dir / "SKILL.md"

    if not skill_md.exists():
        # A placeholder directory with only a README is fine at this stage.
        return errors

    text = skill_md.read_text(encoding="utf-8")

    errors.extend(_check_frontmatter(skill_md, text))

    for lineno, line in enumerate(text.splitlines(), start=1):
        for match in FORBIDDEN_PATH_PATTERN.finditer(line):
            errors.append(
                f"{skill_md}:{lineno}: references a path outside the skill directory:"
                f" {match.group(0)}"
            )
        targets = [
            t.split("#", 1)[0]
            for t in LINK_PATTERN.findall(line)
            if "://" not in t and not t.startswith(("#", "mailto:", "/", "../"))
        ]
        targets += SKILL_PATH_PATTERN.findall(line)
        for target in targets:
            if target and not (skill_dir / target).exists():
                errors.append(f"{skill_md}:{lineno}: referenced file does not exist: {target}")

    return errors


def main() -> int:
    if not SKILLS_DIR.is_dir():
        print(f"error: {SKILLS_DIR} does not exist", file=sys.stderr)
        return 1

    skill_dirs = sorted(p for p in SKILLS_DIR.iterdir() if p.is_dir())
    all_errors: list[str] = []
    for skill_dir in skill_dirs:
        all_errors.extend(validate_skill(skill_dir))

    if all_errors:
        for error in all_errors:
            print(f"FAIL: {error}", file=sys.stderr)
        return 1

    completed = [d for d in skill_dirs if (d / "SKILL.md").exists()]
    print(f"OK: {len(completed)}/{len(skill_dirs)} skill(s) have a SKILL.md; all valid.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
