# Repo-root agent context files (kept local, not committed).
# Anchored so benchmark fixture overlays can still ship their own AGENTS.md.
/AGENTS.md
/CLAUDE.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
*.whl
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Testing / coverage / tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Context Garden runtime state (project-local, generated).
# Keep config.yaml shareable; ignore everything else under it.
.context-garden/*
!.context-garden/config.yaml

# Per-Skill local stores (generated when a Skill's CLI is run from repo root).
.compost/
.pruner/
.seedbank/
.trellis/

# Local Claude Code settings.
.claude/settings.local.json

# Benchmark results are generated artifacts, not source.
benchmarks/results/*
!benchmarks/results/.gitkeep
