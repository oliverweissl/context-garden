# Copy to ~/.config/context-garden/ops.env (chmod 600). Never commit it.
# A backend whose values are missing offers no tools.

# OpenProject: Account settings > Access tokens > API
OPENPROJECT_URL=https://openproject.example.com
OPENPROJECT_API_KEY=
OPENPROJECT_PROJECT=your-project-identifier

# Jenkins: User > Configure > API Token
JENKINS_URL=https://jenkins.example.com
JENKINS_USER=
JENKINS_API_TOKEN=

# OPS_READ_ONLY=1   hide every tool that writes
