{
  "description": "Codex variant of hooks.json. Codex has no Agent/Task tool and no Read/Grep/Glob tools (it reads through the shell), and its PreToolUse accepts only deny, never allow/ask/updatedInput: so no mycelium hooks, compost always redirects (--codex), seedbank watches shell commands only. Codex runs plugin hooks only once trusted; the Context Garden app trusts these after installing or updating the plugin. Every hook is a no-op unless its skill is on.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/compost/bin/compost\" hook --codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/seedbank/bin/seedbank\" hook",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/seedbank/bin/seedbank\" hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/pruner/bin/pruner\" hook",
            "timeout": 25
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/garden.py\" hook session-start",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/greenhouse/bin/greenhouse\" hook session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/greenhouse/bin/greenhouse\" hook session-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
