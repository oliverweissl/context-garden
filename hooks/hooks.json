{
  "description": "seedbank: record Read/Grep/Glob calls as observations (async). mycelium: gate Agent calls (brief fields, duplicates, known notes) and remind to record findings.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/seedbank/bin/seedbank\" hook",
            "async": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/mycelium/bin/mycelium\" hook post-agent",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/mycelium/bin/mycelium\" hook pre-agent",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
